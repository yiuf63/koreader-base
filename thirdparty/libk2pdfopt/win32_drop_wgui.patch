From: KOReader <https://github.com/koreader/koreader-base>
Subject: [PATCH] win32: drop the need for willuslib/wgui.c

Upstream did the same in `c2bc709 drop the need for willuslib/wgui.c` (see
koreader-base's newer libk2pdfopt pin, `64aa9cc`). Backport it here so the
library actually links on Windows:

- `wgui.c` is the Win32 GUI backend, and pulls in a whole chain of
  `willusgui_*` / `win*` helpers (`winbmp.c`, `winmbox.c`, `wincomdlg.c`,
  `wininet.c`, `winshellwapi.c`, ...) that the library never builds.
- `k2sys.c` only used it for a `k2printf` semaphore, which upstream
  disabled with `#if 0`.

While at it, build `wsys.c`'s Win32 counterpart: with MinGW defining
`WIN32` (and `WILLUS_X863264`), `willus.h` enables `HAVE_WIN32_API`, so
`wsys.c` calls `win_has_own_window()` / `win_full_exe_name()`, which live
in `willuslib/win.c` and were not part of the build.

--- a/lib/CMakeLists.txt
+++ b/lib/CMakeLists.txt
@@ -49,11 +49,15 @@ add_library(k2pdfopt
     ../willuslib/string.c
     ../willuslib/token.c
     ../willuslib/wfile.c
-    ../willuslib/wgui.c
     ../willuslib/willusversion.c
     ../willuslib/wleptonica.c
     ../willuslib/wsys.c
 )
+if(WIN32)
+    # NOTE: `wsys.c` calls into these through its `HAVE_WIN32_API` paths, which
+    #       only get enabled on Windows (see `willuslib/willus.h`).
+    target_sources(k2pdfopt PRIVATE ../willuslib/win.c)
+endif()
 set_target_properties(k2pdfopt PROPERTIES SOVERSION 2)
 set_target_properties(k2pdfopt PROPERTIES
     C_VISIBILITY_PRESET hidden
--- a/k2pdfoptlib/k2sys.c
+++ b/k2pdfoptlib/k2sys.c
@@ -153,6 +153,7 @@ int k2printf(const char *fmt,...)
     {
     va_list args;
     int     status;
+#if 0
     static void *k2printf_semaphore;
     static int count=0;
     
@@ -161,6 +162,7 @@ int k2printf(const char *fmt,...)
     count++;
     if (k2printf_semaphore)
         willusgui_semaphore_status_wait(k2printf_semaphore);
+#endif
     status=0;
     va_start(args,fmt);
 #ifdef HAVE_K2GUI
@@ -188,7 +190,9 @@ int k2printf(const char *fmt,...)
     fflush(stdout);
 #endif
     va_end(args);
+#if 0
     willusgui_semaphore_release(k2printf_semaphore);
+#endif
     return(status);
     }
 
