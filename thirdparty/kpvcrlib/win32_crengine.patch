diff --git a/crengine/src/lvstring_win32_compat.h b/crengine/src/lvstring_win32_compat.h
new file mode 100644
index 00000000..a3358876
--- /dev/null
+++ b/crengine/src/lvstring_win32_compat.h
@@ -0,0 +1,62 @@
+#ifndef LVSTRING_WIN32_COMPAT_H
+#define LVSTRING_WIN32_COMPAT_H
+
+#if !defined(__SYMBIAN32__) && defined(_WIN32)
+#include <windows.h>
+#include "lvstring.h"
+
+static inline int char32_to_wchar(const lString32 &str, wchar_t *wbuf, int maxchars) {
+    int n = 0;
+    for (int i = 0; i < str.length() && n < maxchars; i++) {
+        char32_t c = str[i];
+        if (c < 0x10000) {
+            wbuf[n++] = (wchar_t)c;
+        } else if (n + 1 < maxchars) {
+            c -= 0x10000;
+            wbuf[n++] = (wchar_t)(0xD800 + (c >> 10));
+            wbuf[n++] = (wchar_t)(0xDC00 + (c & 0x3FF));
+        }
+    }
+    return n;
+}
+
+static inline lString32 wchar_to_char32(const wchar_t *wbuf, int len) {
+    lString32 result;
+    result.reserve(len);
+    for (int i = 0; i < len; i++) {
+        wchar_t wc = wbuf[i];
+        if (wc >= 0xD800 && wc <= 0xDBFF && i + 1 < len) {
+            wchar_t wc2 = wbuf[i + 1];
+            if (wc2 >= 0xDC00 && wc2 <= 0xDFFF) {
+                result += (char32_t)(((wc - 0xD800) << 10) + (wc2 - 0xDC00) + 0x10000);
+                i++;
+                continue;
+            }
+        }
+        result += (char32_t)wc;
+    }
+    return result;
+}
+
+static inline void lString32_to_LPCWSTR_free(const lString32 &str, wchar_t **out, int *outlen) {
+    int wlen = str.length() * 2 + 1;
+    wchar_t *wbuf = (wchar_t *)malloc(wlen * sizeof(wchar_t));
+    if (wbuf) {
+        *outlen = char32_to_wchar(str, wbuf, wlen);
+        wbuf[*outlen] = 0;
+    } else {
+        *outlen = 0;
+        wbuf = NULL;
+    }
+    *out = wbuf;
+}
+
+#define L32_TO_W(str, wvar, wlenvar) \
+    wchar_t *_wbuf_##wvar; int _wlen_##wvar; \
+    lString32_to_LPCWSTR_free(str, &_wbuf_##wvar, &_wlen_##wvar); \
+    wchar_t *wvar = _wbuf_##wvar
+
+#define L32_TO_W_FREE(wvar) free(_wbuf_##wvar)
+
+#endif
+#endif
